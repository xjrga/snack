<?xml version='1.0' encoding='UTF-8'?>
<project name="Snack" default="" basedir=".">
    <!-->Properties</-->
    <property name="project.creator">Jorge R. Garcia de Alba</property>
    <property name="project.name">snack</property>
    <property name="project.zip">snack-1710</property>
    <property name="project.jar">snack</property>
    <property name="project.class">io.github.xjrga.snack.gui.Main</property>
    <property name="project.backup.dir">/mnt/backup/Backup</property>
    <property name="project.backup.tgz">snack-1710</property>
    <property name="project.site.dir">${user.home}"</property>
    <property name="project.jpda.address">5010</property>
    <!-->Timestamps</-->
    <tstamp>
        <format property="timestamp" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tstamp>
    <tstamp>
        <format property="backup_timestamp" pattern="yyyy_MM_dd_HH_mm_ss"/>
    </tstamp>
    <!-->Libraries</-->
    <path id="libraries">
        <fileset dir="lib">
            <include name="**/*.jar"/>
        </fileset>
    </path>
    <!-->Targets</-->
    <target name="app-clean" depends="">
        <echo>${timestamp}</echo>
        <delete dir="distribution"/>
    </target>
    <!-->Create thin application</-->
    <target name="app-thin" depends="app-clean">
        <echo>${timestamp}</echo>
        <manifestclasspath property="manifest-classpath" jarfile="${project.jar}.jar">
            <classpath refid="libraries"/>
        </manifestclasspath>
        <jar destfile="distribution/${project.zip}/${project.jar}.jar" excludes="" basedir="build/main/classes">
            <manifest>
                <attribute name="Created-By" value="${project.creator}"/>
                <attribute name="Main-Class" value="${project.class}"/>
                <attribute name="Class-Path" value="${manifest-classpath}"/>
            </manifest>
        </jar>
        <copy todir="distribution/${project.zip}/lib">
            <fileset dir="lib">
                <include name="**/*.jar"/>
            </fileset>
        </copy>
        <copy todir="distribution/${project.zip}/config">
            <fileset dir="config">
                <include name="**/*.*"/>
            </fileset>
        </copy>
        <copy todir="distribution/${project.zip}/database">
            <fileset dir="database">
                <include name="**/*.*"/>
            </fileset>
        </copy>
        <copy todir="distribution/${project.zip}/models">
            <fileset dir="models">
                <include name="**/*"/>
            </fileset>
        </copy>
    </target>
    <!-->Create fat application</-->
    <target name="app-fat" depends="app-clean">
        <echo>${timestamp}</echo>
        <unzip overwrite="true" dest="build/main/classes">
            <fileset dir="lib">
                <include name="**/*.jar"/>
            </fileset>
        </unzip>
        <manifestclasspath property="manifest-classpath" jarfile="build/${project.jar}.jar">
            <classpath refid="libraries"/>
        </manifestclasspath>
        <jar destfile="distribution/${project.zip}/${project.jar}.jar" excludes="" basedir="build/main/classes">
            <manifest>
                <attribute name="Created-By" value="${project.creator}"/>
                <attribute name="Main-Class" value="${project.class}"/>
                <attribute name="Class-Path" value="${manifest-classpath}"/>
            </manifest>
        </jar>
        <copy todir="distribution/${project.zip}/config">
            <fileset dir="config">
                <include name="**/*.*"/>
            </fileset>
        </copy>
        <copy todir="distribution/${project.zip}/database">
            <fileset dir="database">
                <include name="**/*.*"/>
            </fileset>
        </copy>
        <copy todir="distribution/${project.zip}/models">
            <fileset dir="models">
                <include name="**/*"/>
            </fileset>
        </copy>
    </target>
    <target name="app-zip" depends="">
        <zip destfile="distribution/${project.zip}.zip" basedir="distribution" includes="${project.zip}/**"/>
    </target>
    <target name="app-sign" depends="">
        <exec executable="gpg">
            <arg line="--output"/>
            <arg line="distribution/${project.zip}.zip.asc"/>
            <arg line="--detach-sig"/>
            <arg line="distribution/${project.zip}.zip"/>
        </exec>
    </target>
    <target name="app-verify" depends="">
        <exec executable="gpg">
            <arg line="--verify"/>
            <arg line="distribution/${project.zip}.zip.asc"/>
            <arg line="distribution/${project.zip}.zip"/>
        </exec>
    </target>
    <target name="app-run" depends="">
        <echo>${timestamp}</echo>
        <java jar="distribution/${project.zip}/${project.jar}.jar" maxmemory="2g" fork="true" dir="distribution/${project.zip}" failonerror="false"/>
    </target>
    <target name="app-debug" depends="">
        <echo>${timestamp}</echo>
        <java jar="distribution/${project.zip}/${project.jar}.jar" maxmemory="2g" fork="true" dir="distribution/${project.zip}" failonerror="false">
            <arg line="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"/>
            <jvmarg value="-agentlib:jdwp=transport=dt_socket,address=${project.jpda.address}"/>
        </java>
        <exec executable="jdb">
            <arg line="-sourcepath source -classpath build/main/classes:libraries io.github.xjrga.snack.gui.Main"/>
        </exec>
    </target>
    <target name="src-clean" depends="">
        <echo>${timestamp}</echo>
        <delete dir="build"/>
    </target>
    <target name="src-build" depends="src-clean">
        <echo>${timestamp}</echo>
        <!--> Build main classes </-->
        <mkdir dir="build/main/classes"/>
        <javac includeantruntime="false" srcdir="src/main/java" release="21" debug="true" destdir="build/main/classes">
            <classpath refid="libraries"/>
        </javac>
        <!--> Build test classes </-->
        <mkdir dir="build/test/classes"/>
        <mkdir dir="distribution"/>
        <javac srcdir="src/test/java" release="21" debug="true" destdir="build/test/classes" includeAntRuntime="false">
            <classpath>
                <path>
                    <fileset dir="lib">
                        <include name="**/*.jar"/>
                    </fileset>
                </path>
                <pathelement location="build/main/classes"/>
            </classpath>
        </javac>
        <!--> Copy resources </-->
        <mkdir dir="build/main/classes/resources"/>
        <copy todir="build/main/classes/resources">
            <fileset dir="src/main/resources">
                <include name="**/*.*"/>
            </fileset>
        </copy>
        <copy todir="build/main/classes">
            <fileset dir=".">
                <include name="**/*.md"/>
            </fileset>
        </copy>
    </target>
    <target name="src-run" depends="">
        <echo>${timestamp}</echo>
        <java classname="${project.class}" fork="true" failonerror="true">
            <classpath>
                <path>
                    <fileset dir="lib">
                        <include name="**/*.jar"/>
                    </fileset>
                </path>
                <pathelement location="build/main/classes"/>
            </classpath>
        </java>
    </target>
    <target name="src-info" depends="">
        <echo>Date: ${timestamp}</echo>
        <echo>Name: ${ant.project.name}</echo>
        <echo>Directory:${basedir}</echo>
        <echo>Java version: ${ant.java.version}</echo>
        <echo>Java classpath: "${java.class.path}</echo>
    </target>
    <target name="src-backup" depends="src-clean,app-clean">
        <echo>Backup files to ${project.backup.dir}/${project.backup.tgz}_${backup_timestamp}.tgz</echo>
        <exec executable="tar">
            <arg line="czfv"/>
            <arg line="${project.backup.dir}/${project.backup.tgz}_${backup_timestamp}.tgz"/>
            <arg line="."/>
        </exec>
        <echo>Backup files to ${project.backup.dir}/${project.backup.tgz}_${backup_timestamp}.tgz</echo>
    </target>
    <target name="src-javadoc" depends="">
        <javadoc use="true" version="true" destdir="docs/html" author="true">
            <fileset dir="src/main/java" defaultexcludes="yes">
                <include name="io/github/xjrga/**"/>
                <!--<exclude name="io/github/xjrga/MyTest*"/>-->
            </fileset>
            <classpath>
                <path>
                    <fileset dir="lib">
                        <include name="**/*.jar"/>
                    </fileset>
                </path>
                <pathelement location="build/main/classes"/>
            </classpath>
        </javadoc>
    </target>
    <target name="src-test" depends="src-clean,src-build">
        <junit printsummary="true" fork="true" dir=".">
            <classpath>
                <path>
                    <fileset dir="lib">
                        <include name="**/*.jar"/>
                    </fileset>
                </path>
                <pathelement location="build/main/classes"/>
                <pathelement location="build/test/classes"/>
            </classpath>
            <formatter usefile="false" type="plain"/>
            <batchtest todir="build/test/data">
                <fileset dir="build/test/classes"/>
            </batchtest>
        </junit>
    </target>
    <target name="app-site" depends="">
        <echo>${timestamp}</echo>
        <copy todir="${project.site.dir}" overwrite="true" file="distribution/${project.zip}-sources.zip"/>
        <copy todir="${project.site.dir}" overwrite="true" file="distribution/${project.zip}.zip"/>
        <copy todir="${project.site.dir}" overwrite="true" file="distribution/${project.zip}.zip.asc"/>
    </target>
    <target name="app-thin-and-run" depends="src-build,app-thin,app-run,src-zip">
        <echo>${timestamp}</echo>
    </target>
    <target name="app-thin-and-zip" depends="src-build,app-thin,app-zip,src-zip">
        <echo>${timestamp}</echo>
    </target>
    <target name="app-fat-and-run" depends="src-build,app-fat,app-run,src-zip">
        <echo>${timestamp}</echo>
    </target>
    <target name="app-fat-and-zip" depends="src-build,app-fat,app-zip,src-zip">
        <echo>${timestamp}</echo>
    </target>
    <target name="src-zip" depends="">
        <echo>${timestamp}</echo>
        <zip destfile="distribution/${project.zip}-sources.zip" basedir="src/main/java" includes="**/*.java"/>
    </target>
    <target name="+ create dirs" depends="">
        <echo>${timestamp}</echo>
        <mkdir dir="lib"/>
        <mkdir dir="src"/>
        <mkdir dir="src/main"/>
        <mkdir dir="src/main/java"/>
        <mkdir dir="src/main/resources"/>
        <mkdir dir="src/test"/>
        <mkdir dir="src/test/java"/>
        <mkdir dir="src/test/resources"/>
        <mkdir dir="build/main/classes"/>
        <mkdir dir="build/main/classes/resources"/>
        <mkdir dir="build/test/classes"/>
        <mkdir dir="build/test/classes/resources"/>
        <mkdir dir="build/test/data"/>
        <mkdir dir="database/db"/>
        <mkdir dir="database/sql"/>
        <mkdir dir="distribution"/>
        <mkdir dir="docs/html"/>
    </target>
    <!-- Compound Targets -->
    <target name="src-build-and-run" depends="src-build,src-run">
        <echo>${timestamp}</echo>
    </target>
</project>
